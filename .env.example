# Official course API. Read operations are safe; submission remains disabled below.
GAIA_API_URL=https://agents-course-unit4-scoring.hf.space

# A Hugging Face token is free. It is needed later for the official gated
# attachment fallback after you accept the GAIA dataset access conditions.
HF_TOKEN=

# Safe execution defaults.
DRY_RUN=true
ALLOW_SUBMIT=false
ZERO_COST_MODE=true
ALLOW_PAID_SERVICES=false

# Runtime paths. These are private and excluded from version control.
RUNS_DIR=runs
ARTIFACTS_DIR=runs/artifacts
STOCKFISH_PATH=
CHESS_ENGINE_DEPTH=18
CHESS_ENGINE_MULTIPV=3
MEDIA_CACHE_DIR=runs/media
FFMPEG_EXECUTABLE=ffmpeg
FFPROBE_EXECUTABLE=ffprobe
YTDLP_EXECUTABLE=yt-dlp
ASR_MODEL=small.en
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
MAX_MEDIA_DURATION_SECONDS=14400
VIDEO_COARSE_FPS=1
VIDEO_DENSE_FPS=6

# Current public evaluation guard. The runtime snapshot still remains authoritative.
EXPECTED_QUESTION_COUNT=20
TASK_PROFILES_VERSION=2026-08-26-v1
TASK_PROFILES_PATH=config/task_profiles.json

# Reliability budgets.
HTTP_TIMEOUT_SECONDS=30
DOWNLOAD_TIMEOUT_SECONDS=120
MAX_ATTACHMENT_BYTES=104857600
ATTACHMENT_MAX_ATTEMPTS=3
ATTACHMENT_RETRY_BASE_SECONDS=0.5
SEARCH_MAX_ATTEMPTS=3
SEARCH_RETRY_BASE_SECONDS=0.5
SEARCH_RETRY_MAX_SECONDS=8
SEARCH_RETRY_JITTER_RATIO=0.2
SEARCH_CACHE_TTL_SECONDS=86400
SEARCH_PRIMARY_MIN_INTERVAL_SECONDS=0
SEARCH_SECONDARY_MIN_INTERVAL_SECONDS=0
MAX_PAGE_BYTES=5242880
PAGE_MAX_REDIRECTS=5
PAGE_MIN_EXTRACTED_CHARS=80
PAGE_MAX_ATTEMPTS=2
PAGE_RETRY_BASE_SECONDS=0.5
PAGE_RETRY_MAX_SECONDS=4
PAGE_RETRY_JITTER_RATIO=0.2
MEDIAWIKI_MAX_HISTORY_PAGES=10
MEDIAWIKI_REVISION_BATCH_SIZE=50
SOURCE_MAX_FLAGGED_LINE_RATIO=0.4
SOURCE_MAX_INJECTION_FINDINGS=20
SOURCE_MIN_REMAINING_CHARS=40
MAX_MODEL_SOURCE_CHARS=100000
MAX_RESEARCH_STEPS=16
MAX_REPLAN=3
RESEARCH_PLANNING_INTERVAL=4
RESEARCH_MAX_TOOL_CALLS=16
RESEARCH_TOOL_TIMEOUT_SECONDS=30
RESEARCH_REQUIRE_INDEPENDENT_RETRIEVAL=false
MAX_VERIFIER_RETRIES=3
MAX_TASK_CONCURRENCY=4

# Optional content-free traces. Keep `none` unless the matching extra is installed.
TELEMETRY_BACKEND=none
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
